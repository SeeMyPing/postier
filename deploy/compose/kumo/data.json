{
  "version": 1,
  "hostname": "mta.postier.test",
  "listen": {
    "http": "0.0.0.0:8000",
    "smtp": "0.0.0.0:2525"
  },
  "log_hook": {
    "url": "http://ingest:8081/v1/kumo/records",
    "batch_size": 100
  },
  "queue": {
    "retry_interval": "5 seconds",
    "max_retry_interval": "10 seconds",
    "max_age": "1 minute"
  },
  "domains": {
    "acme.test": {
      "selector": "pst1",
      "key_file": "/opt/kumomta/etc/dkim/acme.test.pst1.key"
    }
  },
  "inbound_domains": {
    "bounce.acme.test": true,
    "fbl.postier.test": true
  },
  "routes": {
    "*": {
      "host": "mailpit",
      "port": 1025
    },
    "sink.test": {
      "host": "smtpsink",
      "port": 2525
    }
  }
}
